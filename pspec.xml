<?xml version="1.0" ?>
<!DOCTYPE PISI SYSTEM "https://www.pisilinux.org/projeler/pisi/pisi-spec.dtd">
<PISI>
    <Source>
        <Name>dns-changer</Name>
        <Homepage>https://github.com/TeknoAnka/dns-changer</Homepage>
        <Packager>
            <Name>Solzic0</Name>
            <Email>solzic0@yandex.com</Email>
        </Packager>
        <License>GPLv3</License>
        <IsA>app:gui</IsA>
        <Summary>DNS Changer - Simple DNS Manager for LupuS</Summary>
        <Description>DNS Changer is a simple DNS manager built with PyQt6 for the LupuS Operating System, allowing users to easily change their DNS settings.</Description>
    </Source>

    <Package>
        <Name>dns-changer</Name>
        <RuntimeDependencies>
            <Dependency>python3</Dependency>
            <Dependency>python3-pyqt6</Dependency>
        </RuntimeDependencies>
        <Files>
            <Path fileType="executable">/usr/bin/dns-changer</Path>
            <Path fileType="data">/usr/share/dns-changer</Path>
            <Path fileType="data">/usr/share/applications/com.teknoanka.dns-changer.desktop</Path>
            <Path fileType="data">/usr/share/icons/hicolor/128x128/apps/dns-changer.png</Path>
            <Path fileType="doc">/usr/share/doc/dns-changer</Path>
        </Files>
    </Package>

    <History>
        <Update release="1">
            <Date>2026-08-09</Date>
            <Version>2.0.0</Version>
            <Comment>DNS Changer pisi package release</Comment>
            <Name>Solzic0</Name>
            <Email>solzic0@yandex.com</Email>
        </Update>
    </History>
</PISI>
