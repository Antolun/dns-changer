#!/usr/bin/env python3
import sys
import os
import shutil
import shlex
import pwd

def setup_sys_path():
    # 1. Check real directory of current script
    script_dir = os.path.dirname(os.path.realpath(__file__))
    if os.path.exists(os.path.join(script_dir, "ui", "ui_main.py")):
        if script_dir not in sys.path:
            sys.path.insert(0, script_dir)
        return script_dir

    # 2. Check current working directory
    cwd = os.getcwd()
    if os.path.exists(os.path.join(cwd, "ui", "ui_main.py")):
        if cwd not in sys.path:
            sys.path.insert(0, cwd)
        return cwd

    # 3. Check candidate installation directories
    candidate_dirs = []
    
    home = os.environ.get("HOME")
    if home:
        candidate_dirs.append(os.path.join(home, ".local", "share", "dns-changer"))

    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user:
        candidate_dirs.append(f"/home/{sudo_user}/.local/share/dns-changer")

    pkexec_uid = os.environ.get("PKEXEC_UID")
    if pkexec_uid:
        try:
            user_entry = pwd.getpwuid(int(pkexec_uid))
            candidate_dirs.append(os.path.join(user_entry.pw_dir, ".local", "share", "dns-changer"))
        except Exception:
            pass

    if os.geteuid() == 0 and os.path.exists("/home"):
        try:
            for user in os.listdir("/home"):
                candidate_dirs.append(os.path.join("/home", user, ".local", "share", "dns-changer"))
        except Exception:
            pass

    candidate_dirs.extend([
        "/usr/local/share/dns-changer",
        "/usr/share/dns-changer",
        "/opt/dns-changer"
    ])

    for path in candidate_dirs:
        if path and os.path.exists(os.path.join(path, "ui", "ui_main.py")):
            if path not in sys.path:
                sys.path.insert(0, path)
            return path

    return None

def find_kdesu():
    candidates = [
        shutil.which("kdesu"),
        "/usr/lib/kf6/kdesu",
        "/usr/lib/libexec/kf6/kdesu",
        "/usr/libexec/kf6/kdesu",
        "/usr/lib/kf5/kdesu",
        "/usr/lib/libexec/kf5/kdesu",
        "/usr/libexec/kf5/kdesu",
    ]
    for p in candidates:
        if p and os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return None

def ensure_root():
    if os.geteuid() == 0:
        return

    script_path = os.path.abspath(sys.argv[0])

    # 1. Polkit pkexec (Modern Freedesktop / KDE Polkit grafiksel şifre sorma)
    pkexec_path = shutil.which("pkexec")
    if pkexec_path:
        env_vars = []
        for var in ["DISPLAY", "XAUTHORITY", "WAYLAND_DISPLAY", "QT_QPA_PLATFORM", "XDG_RUNTIME_DIR"]:
            if var in os.environ:
                env_vars.append(f"{var}={os.environ[var]}")
        
        args = [pkexec_path]
        if env_vars:
            args.extend(["env"] + env_vars)
        args.extend([sys.executable, script_path] + sys.argv[1:])
        try:
            os.execv(pkexec_path, args)
        except Exception:
            pass

    # 2. KDE kdesu (xauth binary'si mevcutsa KDE şifre sorma penceresi açar)
    kdesu_path = find_kdesu()
    if kdesu_path and shutil.which("xauth"):
        cmd_str = shlex.join([sys.executable, script_path] + sys.argv[1:])
        try:
            os.execv(kdesu_path, [kdesu_path, "-c", cmd_str])
        except Exception:
            pass

    # 3. Terminal sudo düşüşü (Grafiksel araçlar bulunamazsa)
    sudo_path = shutil.which("sudo")
    if sudo_path:
        args = [sudo_path, "-E", sys.executable, script_path] + sys.argv[1:]
        try:
            os.execv(sudo_path, args)
        except Exception as e:
            print(f"Failed to execute with sudo: {e}", file=sys.stderr)
            sys.exit(1)

    print("Failed to obtain administrator privileges (pkexec, kdesu, or sudo could not be found).", file=sys.stderr)
    sys.exit(1)

def main():
    setup_sys_path()
    ensure_root()

    # Enable High DPI scaling
    os.environ["QT_AUTO_SCREEN_SCALE_FACTOR"] = "1"
    
    from PyQt6.QtWidgets import QApplication
    from ui.ui_main import MainWindow

    app = QApplication(sys.argv)
    app.setApplicationName("LupuS DNS Changer")
    app.setOrganizationName("TeknoAnka")
    
    window = MainWindow()
    window.show()
    
    sys.exit(app.exec())

if __name__ == "__main__":
    main()


